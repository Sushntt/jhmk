# Airtable Configuration
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here
# Requires an "Orders" table with fields: Customer Name, Phone, Address, Items (JSON text),
# Total (number), Status (single select), Created At (ISO date text).
# See lib/airtable.ts for full schema notes.

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# WhatsApp Business Number (with country code, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=917200661501

# Admin dashboard access (/admin and /api/analytics)
# NOT prefixed with NEXT_PUBLIC_ so these stay server-side only.
# If unset, the dashboard is locked rather than left open.
ADMIN_USER=chinkara
ADMIN_PASSWORD=change_this_to_a_long_random_string
